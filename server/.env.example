# Safe template only: this file is NOT loaded automatically.
# From server/, copy this to .env if you want to configure the port.
# npm start loads .env through Node's --env-file-if-exists option.
# Existing terminal environment variables take precedence over .env values.
# Without either setting, the server uses port 3000.
PORT=3000
# Temporary unauthenticated broadcast test. Only the exact value true enables it.
# Restart after changing this. Keep false outside an intentional test window.
SOCKET_SPIKE_ENABLED=false
